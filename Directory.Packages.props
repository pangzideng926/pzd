<Project>

  <!-- NuGet 中央包管理：csproj 只写 PackageReference，版本一律写在这里（architecture.md §16.3） -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- 36 号票：集成测试载体的数据库驱动与容器来源 -->
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.16.0" />
    <!-- 06 号票：ORM 选型见 architecture.md §5，映射集中在 Pzd.Infrastructure -->
    <PackageVersion Include="SqlSugarCore" Version="5.1.4.221" />
    <!--
      SqlSugarCore 传递依赖 System.Security.Cryptography.Pkcs 8.0.1，带两个已知漏洞（NU1902/NU1903），
      在「警告即错误」下会直接构建失败。顶到同主版本的当前安全版本，不改变对外行为。
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
