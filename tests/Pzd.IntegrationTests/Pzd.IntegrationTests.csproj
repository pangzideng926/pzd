<Project Sdk="Microsoft.NET.Sdk">

  <!--
    集成测试工程：36 号票建立载体（fixture），06 号票起在本工程追加业务断言，
    因此从 06 起引用 Pzd.Infrastructure。36 原有「绝不引用任何 Pzd.* 项目」只适用于
    fixture 载体本身（Fixtures/** 仍然不依赖任何 Pzd.* 项目），测试用例可以有依赖。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 的测试项目必须是可执行程序 -->
    <OutputType>Exe</OutputType>
    <!-- .NET 10 SDK 不再支持 VSTest 目标，xUnit v3 需显式启用 Microsoft.Testing.Platform 的 dotnet test -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="Testcontainers.MySql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pzd.Infrastructure\Pzd.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
