<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    中央包管理（CPM）要求源映射：显式声明唯一包源，避免不同机器上的
    用户级 NuGet.config 引入额外源导致 NU1507，并保证 restore 可复现。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
