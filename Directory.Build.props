<Project>

  <!-- 公共编译约定：新增项目自动继承，csproj 不再逐个复制（architecture.md §16.3） -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- 版本号由 git tag 推导，标签形如 v1.4.0（architecture.md §15.1） -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <!-- 全体项目统一注入 MinVer；包版本在 Directory.Packages.props -->
  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

</Project>
