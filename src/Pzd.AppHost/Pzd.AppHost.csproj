<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <PropertyGroup>
    <RootNamespace>Pzd.AppHost</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>pzd-apphost</UserSecretsId>
    <!-- ASPIRE010：本机不装 Aspire CLI bundle，只用 AppHost 起进程；关掉该诊断避免 -warnaserror 直接失败。 -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Pzd.Api/Pzd.Api.csproj" />
  </ItemGroup>

</Project>
