<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <!-- Aspire 编排宿主（03 号票）：唯一启动入口，连接串只经这里注入 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pzd.AppHost</RootNamespace>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>ec8947d5-2160-40e2-8391-2353a2a8cf6f</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.MySql" />
    <PackageReference Include="Aspire.Hosting.Redis" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <!-- 传递依赖里被钉在 2.3.1（有 NU1902 漏洞），显式提升 -->
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pzd.Api\Pzd.Api.csproj" />
  </ItemGroup>

</Project>
